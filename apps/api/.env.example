# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://sami:sami@localhost:5432/sami?schema=public

# Auth (длинные случайные секреты в проде!)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECRET=dev-cookie-secret-change-me

# Payments (ЮKassa) — заполнить перед интеграцией
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:5173/account/orders
