# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database — MySQL 8 (локально brew/docker, прод reg.ru)
DATABASE_URL=mysql://sami:sami@localhost:3306/sami

# Auth (длинные случайные секреты в проде!)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECRET=dev-cookie-secret-change-me

# Payments (Robokassa) — заполнить перед интеграцией
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_IS_TEST=true

# Payments (ЮKassa) — резервный провайдер, можно пропустить
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:5173/account/orders
