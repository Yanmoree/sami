{
  "name": "sami",
  "version": "0.1.0",
  "private": true,
  "description": "SAMI — minimalist clothing brand storefront",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:web": "npm --workspace @sami/web run dev",
    "dev:api": "npm --workspace @sami/api run dev",
    "build": "npm-run-all build:api build:web",
    "build:web": "npm --workspace @sami/web run build",
    "build:demo": "npm --workspace @sami/web run build:demo",
    "build:api": "npm --workspace @sami/api run build",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "npm --workspace @sami/api run db:migrate",
    "db:seed": "npm --workspace @sami/api run db:seed",
    "db:studio": "npm --workspace @sami/api run db:studio",
    "lint": "npm-run-all --parallel lint:*",
    "lint:web": "npm --workspace @sami/web run lint",
    "lint:api": "npm --workspace @sami/api run lint",
    "typecheck": "npm-run-all --parallel typecheck:*",
    "typecheck:web": "npm --workspace @sami/web run typecheck",
    "typecheck:api": "npm --workspace @sami/api run typecheck"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
