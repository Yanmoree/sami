{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm install && npm --workspace @sami/web run build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "echo 'skip-implicit-install'",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
